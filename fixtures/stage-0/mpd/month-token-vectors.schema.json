{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hezo-link:stage-0:mpd:month-token-vectors:v1",
  "title": "Hezo Link MPD v1 public synthetic vector set",
  "description": "Strict shape for deterministic, test-only MPD derivation, validation, UTC-month, and withdrawal vectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_type",
    "fixture_id",
    "safety",
    "contract",
    "derivation_cases",
    "server_digest_cases",
    "utc_month_cases",
    "wire_validation_cases",
    "withdrawal_cases",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_type": {
      "const": "mpd_v1_vector_set"
    },
    "fixture_id": {
      "const": "mpd-v1-month-token-vectors-1"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "derivation_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/derivationCase"
      }
    },
    "server_digest_cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/serverDigestCase"
      }
    },
    "utc_month_cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/utcMonthCase"
      }
    },
    "wire_validation_cases": {
      "$ref": "#/$defs/wireValidationCases"
    },
    "withdrawal_cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/withdrawalCase"
      }
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 96
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "canonicalToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "caseRef": {
      "type": "string",
      "pattern": "^derive-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "test_only",
        "production_secret_material",
        "captured_measurement_material",
        "contains_real_identifier",
        "contains_operational_tokens",
        "contains_protocol_shaped_public_test_values",
        "historical_months_only",
        "operational_use_forbidden",
        "offline_only"
      ],
      "properties": {
        "classification": {
          "const": "public_synthetic"
        },
        "test_only": {
          "const": true
        },
        "production_secret_material": {
          "const": false
        },
        "captured_measurement_material": {
          "const": false
        },
        "contains_real_identifier": {
          "const": false
        },
        "contains_operational_tokens": {
          "const": false
        },
        "contains_protocol_shaped_public_test_values": {
          "const": true
        },
        "historical_months_only": {
          "const": true
        },
        "operational_use_forbidden": {
          "const": true
        },
        "offline_only": {
          "const": true
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "install_secret_length_bytes",
        "salt_label_ascii",
        "salt_label_hex",
        "salt_sha256_hex",
        "hkdf",
        "token_hmac",
        "wire_encoding",
        "server_digest"
      ],
      "properties": {
        "version": {
          "const": "hezo-link/mpd/v1"
        },
        "install_secret_length_bytes": {
          "const": 32
        },
        "salt_label_ascii": {
          "const": "hezo-link/mpd/v1"
        },
        "salt_label_hex": {
          "const": "68657a6f2d6c696e6b2f6d70642f7631"
        },
        "salt_sha256_hex": {
          "const": "2b31a802667ab8e4fc0c152364673f89a140cd1c9c8290b6a201ae3854eb2519"
        },
        "hkdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "info_prefix_ascii", "output_length_bytes"],
          "properties": {
            "hash": {
              "const": "sha256"
            },
            "info_prefix_ascii": {
              "const": "month:"
            },
            "output_length_bytes": {
              "const": 32
            }
          }
        },
        "token_hmac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "message_ascii", "output_length_bytes"],
          "properties": {
            "hash": {
              "const": "sha256"
            },
            "message_ascii": {
              "const": "qualified-protected-installation"
            },
            "output_length_bytes": {
              "const": 32
            }
          }
        },
        "wire_encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "padding", "canonical_reencoding_required", "encoded_length_characters"],
          "properties": {
            "name": {
              "const": "base64url"
            },
            "padding": {
              "const": "forbidden"
            },
            "canonical_reencoding_required": {
              "const": true
            },
            "encoded_length_characters": {
              "const": 43
            }
          }
        },
        "server_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "pepper_length_bytes", "message_representation", "output_length_bytes"],
          "properties": {
            "hash": {
              "const": "sha256"
            },
            "pepper_length_bytes": {
              "const": 32
            },
            "message_representation": {
              "const": "raw_token_bytes"
            },
            "output_length_bytes": {
              "const": 32
            }
          }
        }
      }
    },
    "derivationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "synthetic_install_secret_hex",
        "utc_month",
        "hkdf_info_ascii",
        "hkdf_prk_hex",
        "expected_month_key_hex",
        "expected_token_hex",
        "expected_token_base64url_unpadded"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/caseRef"
        },
        "synthetic_install_secret_hex": {
          "$ref": "#/$defs/hex32"
        },
        "utc_month": {
          "$ref": "#/$defs/month"
        },
        "hkdf_info_ascii": {
          "type": "string",
          "pattern": "^month:[0-9]{4}-(?:0[1-9]|1[0-2])$"
        },
        "hkdf_prk_hex": {
          "$ref": "#/$defs/hex32"
        },
        "expected_month_key_hex": {
          "$ref": "#/$defs/hex32"
        },
        "expected_token_hex": {
          "$ref": "#/$defs/hex32"
        },
        "expected_token_base64url_unpadded": {
          "$ref": "#/$defs/canonicalToken"
        }
      }
    },
    "serverDigestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "token_case_ref",
        "synthetic_month_pepper_hex",
        "hmac_message_representation",
        "expected_token_digest_hex"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "token_case_ref": {
          "$ref": "#/$defs/caseRef"
        },
        "synthetic_month_pepper_hex": {
          "$ref": "#/$defs/hex32"
        },
        "hmac_message_representation": {
          "const": "raw_token_bytes"
        },
        "expected_token_digest_hex": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "utcMonthCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "utc_instant", "expected_utc_month"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "utc_instant": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
        },
        "expected_utc_month": {
          "$ref": "#/$defs/month"
        }
      }
    },
    "wireValidationCases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_length_cases",
        "derivation_mutation_cases",
        "month_cases",
        "token_cases",
        "digest_input_cases",
        "request_month_cases"
      ],
      "properties": {
        "binary_length_cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/binaryLengthCase"
          }
        },
        "derivation_mutation_cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/derivationMutationCase"
          }
        },
        "month_cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/monthValidationCase"
          }
        },
        "token_cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/tokenValidationCase"
          }
        },
        "digest_input_cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/digestInputCase"
          }
        },
        "request_month_cases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/requestMonthCase"
          }
        }
      }
    },
    "binaryLengthCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "target", "supplied_length_bytes", "expected_semantic_code"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "target": {
          "enum": ["install_secret", "month_pepper"]
        },
        "supplied_length_bytes": {
          "enum": [31, 33]
        },
        "expected_semantic_code": {
          "enum": ["install_secret_length_invalid", "month_pepper_length_invalid"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["target"],
            "properties": {
              "target": {
                "const": "install_secret"
              }
            }
          },
          "then": {
            "properties": {
              "expected_semantic_code": {
                "const": "install_secret_length_invalid"
              }
            }
          },
          "else": {
            "properties": {
              "expected_semantic_code": {
                "const": "month_pepper_length_invalid"
              }
            }
          }
        }
      ]
    },
    "derivationMutationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "base_case_ref",
        "mutation",
        "incorrect_token_hex",
        "expected_semantic_code"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "base_case_ref": {
          "$ref": "#/$defs/caseRef"
        },
        "mutation": {
          "enum": [
            "raw_ascii_salt_instead_of_label_digest",
            "hkdf_info_without_month_prefix",
            "token_message_with_trailing_lf",
            "token_message_with_trailing_nul"
          ]
        },
        "incorrect_month_key_hex": {
          "$ref": "#/$defs/hex32"
        },
        "incorrect_token_hex": {
          "$ref": "#/$defs/hex32"
        },
        "expected_semantic_code": {
          "const": "must_not_equal_reference"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["mutation"],
            "properties": {
              "mutation": {
                "enum": [
                  "raw_ascii_salt_instead_of_label_digest",
                  "hkdf_info_without_month_prefix"
                ]
              }
            }
          },
          "then": {
            "required": ["incorrect_month_key_hex"],
            "properties": {
              "incorrect_month_key_hex": {
                "$ref": "#/$defs/hex32"
              }
            }
          },
          "else": {
            "properties": {
              "incorrect_month_key_hex": false
            }
          }
        }
      ]
    },
    "monthValidationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "candidate", "expected_semantic_code"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "not": {
            "$ref": "#/$defs/month"
          }
        },
        "expected_semantic_code": {
          "const": "month_invalid"
        }
      }
    },
    "tokenValidationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "candidate", "expected_semantic_code"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "expected_semantic_code": {
          "enum": [
            "token_padding_forbidden",
            "token_alphabet_invalid",
            "token_noncanonical",
            "token_length_invalid"
          ]
        }
      }
    },
    "digestInputCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "token_case_ref",
        "synthetic_month_pepper_hex",
        "incorrect_message_representation",
        "incorrect_digest_hex",
        "expected_semantic_code"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "token_case_ref": {
          "$ref": "#/$defs/caseRef"
        },
        "synthetic_month_pepper_hex": {
          "$ref": "#/$defs/hex32"
        },
        "incorrect_message_representation": {
          "const": "ascii_base64url_token"
        },
        "incorrect_digest_hex": {
          "$ref": "#/$defs/hex32"
        },
        "expected_semantic_code": {
          "const": "digest_input_must_be_raw_token_bytes"
        }
      }
    },
    "requestMonthCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "purpose",
        "month_policy_subject",
        "server_utc_month",
        "submitted_months",
        "prior_distinct_rows",
        "expected_distinct_rows",
        "expected_result_class",
        "expected_policy_outcome"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "purpose": {
          "const": "mpd_presence"
        },
        "month_policy_subject": {
          "const": "submitted_month_field"
        },
        "server_utc_month": {
          "$ref": "#/$defs/month"
        },
        "submitted_months": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/month"
          }
        },
        "token_case_ref": {
          "$ref": "#/$defs/caseRef"
        },
        "acceptance_preconditions": {
          "$ref": "#/$defs/presenceAcceptancePreconditions"
        },
        "prior_distinct_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "expected_distinct_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "expected_result_class": {
          "enum": ["non_disclosing_success", "semantic_rejection"]
        },
        "expected_policy_outcome": {
          "enum": [
            "presence_month_accepted",
            "presence_month_past_rejected",
            "presence_month_future_rejected",
            "presence_multiple_months_rejected"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["expected_policy_outcome"],
            "properties": {
              "expected_policy_outcome": {
                "const": "presence_month_accepted"
              }
            }
          },
          "then": {
            "required": ["token_case_ref", "acceptance_preconditions"],
            "properties": {
              "token_case_ref": {
                "$ref": "#/$defs/caseRef"
              },
              "expected_result_class": {
                "const": "non_disclosing_success"
              },
              "acceptance_preconditions": {
                "$ref": "#/$defs/presenceAcceptancePreconditions"
              }
            }
          },
          "else": {
            "properties": {
              "token_case_ref": false,
              "acceptance_preconditions": false,
              "expected_result_class": {
                "const": "semantic_rejection"
              }
            }
          }
        }
      ]
    },
    "withdrawalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "scenario", "steps", "expected_assertions"],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/safeId"
        },
        "scenario": {
          "enum": [
            "existing_open_presence",
            "unknown_open_presence",
            "existing_provisional_presence",
            "duplicate_delete",
            "two_months_independent",
            "final_month_excluded",
            "offline_consent_withdrawal",
            "reconsent_same_month_after_reset"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/withdrawalStep"
          }
        },
        "excluded_months": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/excludedWithdrawalMonth"
          }
        },
        "retry_queue_contract": {
          "$ref": "#/$defs/retryQueueContract"
        },
        "expected_assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "future_presence_receipts_stopped_before_network",
              "future_uploads_stopped_before_network",
              "pending_presence_uploads_deleted",
              "matching_presence_absent",
              "withdrawn_token_presence_absent",
              "new_token_presence_present",
              "unknown_presence_not_disclosed",
              "duplicate_result_unchanged",
              "one_request_per_month",
              "tokens_never_batched",
              "one_retry_item_per_month",
              "retry_payload_is_deletion_capability_only",
              "seed_retained_only_until_all_deletes_succeed_or_expire",
              "seed_destroyed_after_terminal_deletions",
              "final_month_not_submitted",
              "new_seed_generated_after_reconsent",
              "old_seed_never_restored",
              "same_month_recount_possible",
              "new_token_differs_from_withdrawn_token",
              "protection_remains_available"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["scenario"],
            "properties": {
              "scenario": {
                "const": "final_month_excluded"
              }
            }
          },
          "then": {
            "required": ["excluded_months"],
            "properties": {
              "excluded_months": true
            }
          },
          "else": {
            "properties": {
              "excluded_months": false
            }
          }
        },
        {
          "if": {
            "required": ["scenario"],
            "properties": {
              "scenario": {
                "const": "offline_consent_withdrawal"
              }
            }
          },
          "then": {
            "required": ["retry_queue_contract"],
            "properties": {
              "retry_queue_contract": {
                "$ref": "#/$defs/retryQueueContract"
              }
            }
          },
          "else": {
            "properties": {
              "retry_queue_contract": false
            }
          }
        }
      ]
    },
    "presenceAcceptancePreconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_installation",
        "mpd_consent_active",
        "protection_enabled",
        "protection_healthy",
        "integrity_gate_state"
      ],
      "properties": {
        "production_installation": {
          "const": true
        },
        "mpd_consent_active": {
          "const": true
        },
        "protection_enabled": {
          "const": true
        },
        "protection_healthy": {
          "const": true
        },
        "integrity_gate_state": {
          "const": "assumed_satisfied_when_required"
        }
      }
    },
    "retryQueueContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_item_per_month",
        "retained_payload_fields",
        "bounded_control_metadata_fields",
        "forbidden_persisted_fields"
      ],
      "properties": {
        "one_item_per_month": {
          "const": true
        },
        "retained_payload_fields": {
          "const": ["deletion_capability"]
        },
        "bounded_control_metadata_fields": {
          "const": ["attempt_state", "retry_deadline"]
        },
        "forbidden_persisted_fields": {
          "const": [
            "app_attest_identity",
            "consent_record",
            "cross_plane_request_id",
            "device_identifier",
            "installation_secret",
            "multi_month_payload",
            "presence_upload",
            "url_or_browsing_data",
            "user_agent"
          ]
        }
      }
    },
    "excludedWithdrawalMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "month_state", "reason", "token_submission"],
      "properties": {
        "month": {
          "$ref": "#/$defs/month"
        },
        "month_state": {
          "const": "final"
        },
        "reason": {
          "const": "finalized_aggregate_not_deletable"
        },
        "token_submission": {
          "const": "forbidden"
        }
      }
    },
    "withdrawalStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "expected_result_class"],
          "properties": {
            "operation": {
              "enum": ["persist_consent_off", "persist_consent_on", "stop_issuance", "stop_uploads"]
            },
            "expected_result_class": {
              "const": "local_state_updated"
            }
          }
