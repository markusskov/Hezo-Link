{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hezo-link:contract:verdict-reason:v1",
  "title": "Hezo Link verdict reason V1",
  "description": "Strict public verdict-reason shape with forward-compatible stable values and a canonical real UTC whole-second observation time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "family",
    "severity",
    "summary_key",
    "observed_at",
    "freshness"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "Forward-compatible lower-snake-case ASCII reason code."
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "Forward-compatible lower-snake-case ASCII reason family."
    },
    "severity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "Forward-compatible lower-snake-case ASCII reason severity."
    },
    "summary_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.{1,128}(?:\\.|$))[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?:\\.(?=.{1,128}(?:\\.|$))[a-z][a-z0-9]*(?:_[a-z0-9]+)*)*$",
      "description": "Dot-separated localization key whose one-through-128-byte segments use the stable-value grammar. The complete ASCII key is at most 256 bytes."
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "format": "date-time",
      "description": "Canonical real UTC whole-second instant. Validators must assert the date-time format so impossible calendar dates are rejected."
    },
    "freshness": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "Forward-compatible lower-snake-case ASCII evidence-freshness category."
    }
  }
}
