{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hezo-link:url-policy-oracles:address-policy-cases:v1",
  "title": "Hezo Link address-literal policy cases V1",
  "description": "Strict schema for project-authored, offline address-literal syntax cases. It is not an address reachability or destination-safety contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "policyScope",
    "safety",
    "categoryCounts",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "fixtureId": {
      "type": "string",
      "const": "hezo-url-address-policy-v1"
    },
    "policyScope": {
      "type": "string",
      "const": "manual-url-syntax-profile-2-address-literals"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "categoryCounts": {
      "$ref": "#/$defs/categoryCounts"
    },
    "cases": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionBoundary",
        "networkAccessPermitted",
        "operationalUsePermitted",
        "inputOrigin",
        "addressPolicy",
        "containsCapturedInputs",
        "containsOperationalInputs",
        "containsPotentiallyResolvableNames",
        "containsSecrets"
      ],
      "properties": {
        "executionBoundary": {
          "type": "string",
          "const": "offline-only"
        },
        "networkAccessPermitted": {
          "type": "boolean",
          "const": false
        },
        "operationalUsePermitted": {
          "type": "boolean",
          "const": false
        },
        "inputOrigin": {
          "type": "string",
          "const": "project-authored-from-public-rfcs"
        },
        "addressPolicy": {
          "type": "string",
          "const": "reserved-documentation-addresses-and-standard-mechanism-prefixes-only"
        },
        "containsCapturedInputs": {
          "type": "boolean",
          "const": false
        },
        "containsOperationalInputs": {
          "type": "boolean",
          "const": false
        },
        "containsPotentiallyResolvableNames": {
          "type": "boolean",
          "const": false
        },
        "containsSecrets": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "categoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical-ipv4",
        "alternate-ipv4-rejection",
        "ipv6-rfc5952-normalization",
        "ipv4-mapped-ipv6",
        "nat64",
        "6to4",
        "teredo",
        "malformed-ipv6-rejection",
        "zone-identifier-rejection"
      ],
      "properties": {
        "canonical-ipv4": {
          "type": "integer",
          "const": 3
        },
        "alternate-ipv4-rejection": {
          "type": "integer",
          "const": 12
        },
        "ipv6-rfc5952-normalization": {
          "type": "integer",
          "const": 7
        },
        "ipv4-mapped-ipv6": {
          "type": "integer",
          "const": 3
        },
        "nat64": {
          "type": "integer",
          "const": 2
        },
        "6to4": {
          "type": "integer",
          "const": 2
        },
        "teredo": {
          "type": "integer",
          "const": 2
        },
        "malformed-ipv6-rejection": {
          "type": "integer",
          "const": 8
        },
        "zone-identifier-rejection": {
          "type": "integer",
          "const": 3
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "inputURL",
        "expected",
        "rfcReferences",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADDR-[0-9]{3}$(?![\\s\\S])"
        },
        "category": {
          "type": "string",
          "enum": [
            "canonical-ipv4",
            "alternate-ipv4-rejection",
            "ipv6-rfc5952-normalization",
            "ipv4-mapped-ipv6",
            "nat64",
            "6to4",
            "teredo",
            "malformed-ipv6-rejection",
            "zone-identifier-rejection"
          ]
        },
        "inputURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://[^\\r\\n\\u2028\\u2029]+$(?![\\s\\S])"
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/acceptedExpectation"
            },
            {
              "$ref": "#/$defs/rejectedExpectation"
            }
          ]
        },
        "rfcReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rfcReference"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 12,
          "maxLength": 500
        }
      }
    },
    "acceptedExpectation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mechanism": {
                "const": "ordinary"
              },
              "addressFamily": {
                "const": "ipv4"
              }
            },
            "required": [
              "mechanism",
              "addressFamily"
            ]
          },
          "then": {
            "properties": {
              "normalizationBasis": {
                "const": "rfc3986-ipv4"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mechanism": {
                "const": "ordinary"
              },
              "addressFamily": {
                "const": "ipv6"
              }
            },
            "required": [
              "mechanism",
              "addressFamily"
            ]
          },
          "then": {
            "properties": {
              "normalizationBasis": {
                "const": "rfc5952-ipv6"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mechanism": {
                "const": "ipv4-mapped-ipv6"
              }
            },
            "required": [
              "mechanism"
            ]
          },
          "then": {
            "properties": {
              "addressFamily": {
                "const": "ipv4"
              },
              "normalizationBasis": {
                "const": "hezo-profile-2-ipv4-mapped-policy-identity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mechanism": {
                "const": "nat64"
              }
            },
            "required": [
              "mechanism"
            ]
          },
          "then": {
            "properties": {
              "addressFamily": {
                "const": "ipv6"
              },
              "normalizationBasis": {
                "const": "hezo-profile-2-ipv6-rendering"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mechanism": {
                "enum": [
                  "6to4",
                  "teredo"
                ]
              }
            },
            "required": [
              "mechanism"
            ]
          },
          "then": {
            "properties": {
              "addressFamily": {
                "const": "ipv6"
              },
              "normalizationBasis": {
                "const": "rfc5952-ipv6"
              }
            }
          }
        }
      ],
      "required": [
        "outcome",
        "normalizedHost",
        "addressFamily",
        "mechanism",
        "normalizationBasis",
        "isIPLiteral"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "const": "accepted"
        },
        "normalizedHost": {
          "type": "string",
          "minLength": 2,
          "maxLength": 45,
          "pattern": "^[0-9a-f:.]+$(?![\\s\\S])"
        },
        "addressFamily": {
          "type": "string",
          "enum": [
            "ipv4",
            "ipv6"
          ]
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "ordinary",
            "ipv4-mapped-ipv6",
            "nat64",
            "6to4",
            "teredo"
          ]
        },
        "normalizationBasis": {
          "type": "string",
          "enum": [
            "rfc3986-ipv4",
            "rfc5952-ipv6",
            "hezo-profile-2-ipv4-mapped-policy-identity",
            "hezo-profile-2-ipv6-rendering"
          ]
        },
        "isIPLiteral": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "rejectedExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "const": "rejected"
        },
        "reason": {
          "type": "string",
          "enum": [
            "alternate-ipv4-notation",
            "malformed-ipv4",
            "malformed-ipv6",
            "zone-identifier-forbidden"
          ]
        }
      }
    },
    "rfcReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "section",
        "url"
      ],
      "properties": {
        "document": {
          "type": "string",
          "pattern": "^RFC [0-9]{4}$(?![\\s\\S])"
        },
        "section": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$(?![\\s\\S])"
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.rfc-editor\\.org/rfc/rfc[0-9]{4}\\.html#section-[0-9]+(?:\\.[0-9]+)*$(?![\\s\\S])"
        }
      }
    }
  }
}
